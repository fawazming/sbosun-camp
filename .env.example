# ── Application ─────────────────────────────────────────────
APP_ENV=local
APP_DEBUG=true

# ── Database ────────────────────────────────────────────────
# sqlite works with zero setup (default). Switch to mysql for production.
DB_DRIVER=sqlite
DB_DATABASE=storage/camp.sqlite

# MySQL example:
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sbosun_camp
# DB_USERNAME=sbosun
# DB_PASSWORD=change-me

# ── Admin ───────────────────────────────────────────────────
ADMIN_IDLE_TIMEOUT_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Used once by install.php when seeding the first Super Admin.
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@sbosun.org
SEED_ADMIN_PASSWORD=

# ── Payments ────────────────────────────────────────────────
# mock = local test gateway | manual = bank transfer + WhatsApp receipt
# hosted = PayVessel / PayFlow hosted checkout
PAYMENT_MODE=mock
PAYMENT_PROVIDER=PayVessel
PAYMENT_BASE_URL=https://payflow.sgm.ng
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_BUSINESS_ID=
PAYMENT_CALLBACK_URL=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_ALLOWED_IPS=
PAYMENT_REFERENCE_PREFIX=
PAYMENT_ALLOW_PENDING=false

# Manual mode bank details
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_WHATSAPP=

# ── Mail (optional) ─────────────────────────────────────────
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_EMAIL=no-reply@sbosun.org
MAIL_FROM_NAME=SB Osun
